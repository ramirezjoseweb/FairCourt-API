# Seguridad: sustituye esta clave en cualquier entorno publicado.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATABASE_URL=sqlite:///./faircourt.db
CHECKIN_BASE_URL=https://api.ejemplo.es

# Desarrollo local: el OTP aparece únicamente en la terminal de Uvicorn.
OTP_DELIVERY_MODE=console
DEV_PRINT_OTP=true
OTP_TTL_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60

# Brevo: cambia OTP_DELIVERY_MODE a smtp solo después de autenticar el dominio
# y crear una clave SMTP. No confirmes nunca el archivo .env real.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=acceso@faircourt.es
SMTP_FROM_NAME=FairCourt
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
